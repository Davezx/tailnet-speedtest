[Unit]
Description=Tailnet Speedtest (browser-based tailnet bandwidth/latency test)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
# Runs as root so it can read /run/tailscale/tailscaled.sock for whois
# identity attribution and direct-vs-relay info. Drop the tailscale
# integration and use DynamicUser=yes if you don't want that.
ExecStart=/usr/local/bin/tailnet-speedtest -addr :8080 -db /var/lib/tailnet-speedtest/speedtest.db
StateDirectory=tailnet-speedtest
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
